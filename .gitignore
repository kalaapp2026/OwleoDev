# Java / Maven (NEST_BE)
target/
*.class
.idea/
*.iml
*.iws
*.ipr
HELP.md
.mvn/wrapper/maven-wrapper.jar

# Uploaded media - local disk storage from FileStorageService, never belongs in git (and will move
# to real object storage before this matters for a real deploy - see the deployment notes).
uploads/

# Flutter (NEST_FE also keeps its own .gitignore for paths relative to that folder; these are
# extra safety nets, including for nested build dirs it doesn't anchor to, like android/build/
# and android/app/build/ - Gradle's own output, not Flutter's top-level /build/)
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
**/ephemeral/
build/
.gradle/
*.apk
*.aab
*.ipa
ios/Pods/
ios/.symlinks/

# Secrets - real deploy credentials only ever live in the host's env var dashboard, never in git.
.env
.env.*
application-local.properties
application-local.yml
*.pem
*.key

# Claude Code - personal/local tool permissions, not shared project config
.claude/settings.local.json

# OS
.DS_Store
Thumbs.db
