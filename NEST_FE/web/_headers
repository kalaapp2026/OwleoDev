# Cache rules for Cloudflare Workers Static Assets / Pages / Netlify.
#
# This is what decides whether the multi-MB wasm renderer is fetched once or on every single
# visit - the difference between a fast repeat load and burning bandwidth for no reason.
#
# Flutter copies everything in web/ into build/web, so this ships with the build automatically.

# Flutter's asset filenames are NOT content-hashed: assets/fonts/MaterialIcons-Regular.otf is rebuilt
# on every release (tree-shaken to the icons actually used) and assets/brand/owl_icon.png can be
# replaced in place, both under the same URL. Caching them as immutable left browsers showing an old
# logo and blank icons (a stale tree-shaken font without newly added icons). So they revalidate on
# every load: an unchanged file costs a cheap 304 via ETag, a changed one is picked up immediately.
/assets/*
  Cache-Control: public, max-age=0, must-revalidate

# CanvasKit is versioned with the Flutter engine, so it is safe to keep for a long time.
/canvaskit/*
  Cache-Control: public, max-age=31536000, immutable

# index.html must NOT be cached: it names the hashed assets, so a stale copy keeps booting an old
# build whose asset files no longer exist.
/index.html
  Cache-Control: no-cache

/flutter_bootstrap.js
  Cache-Control: no-cache
